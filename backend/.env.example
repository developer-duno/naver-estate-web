# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Supabase Auth (JWT 검증용)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJ...
# Supabase 프로젝트 JWT Secret (Dashboard > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=

# 크롤러 설정
CRAWL_INTERVAL_HOURS=12
CRAWL_DETAIL_INTERVAL_MIN=30
CRAWL_DETAIL_BATCH_SIZE=500
CRAWL_BATCH_SIZE=50
CRAWL_REGIONS=all
CRAWL_REAL_ESTATE_TYPES=APT:ABYG:JGC:PRE

# 인기 단지 선제 크롤링 (매일 10:45/14:45/19:15)
POPULAR_CRAWL_ENABLED=true
POPULAR_CRAWL_BATCH_SIZE=50

# 단지 상세 정보 backfill (detail_crawled_at NULL 단지 보강)
# APT/OPST 만 interval (PR #19 매물상세 패턴 답습), JGC/ABYG/OBYG 는 주1회 cron 유지
COMPLEX_DETAIL_ENABLED=true
COMPLEX_DETAIL_APT_INTERVAL_HOURS=4
COMPLEX_DETAIL_OPST_INTERVAL_HOURS=4
COMPLEX_DETAIL_BATCH_SIZE=1000

# 단지 가치지표 수집 (시세이력 집계 → 중위가/전세가율, 매일 04:30)
# 네이버 API 호출 0 (DB 집계만) — 배치를 크게 잡아도 IP 차단 무관
COMPLEX_METRIC_ENABLED=true
COMPLEX_METRIC_BATCH_SIZE=1000

# 관리자 이메일 (쉼표 구분, 필수 — 미설정 시 관리자 접근 차단)
ADMIN_EMAIL=your-admin@example.com

# CORS (Next.js 프론트엔드 URL) — 텔레그램 장애 알림의 /admin 링크 base 로도 사용
FRONTEND_URL=http://localhost:3000

# 서버 설정
HOST=0.0.0.0
PORT=8000
# 디버그 모드 (true/1 시 상세 에러 노출 — 운영에서는 false)
DEBUG=false

# DB 안전망·관측성 (선택사항 — 미설정 시 아래 기본값)
# statement_timeout: 폭주 쿼리를 N ms 에 죽여 micro 인스턴스 굶김 방지 (0=비활성).
#   Supabase 풀러는 startup options 를 무시하므로 connect 이벤트의 SET 으로 적용.
STATEMENT_TIMEOUT_MS=8000
# 슬로우 쿼리 로깅: N ms 초과 SQL 을 logger.warning 으로 기록 (진단용).
SLOW_QUERY_MS=1000

# 공공데이터 실거래가 수집 (선택사항 — 미설정 시 수집 건너뜀)
PUBLIC_DATA_ENABLED=false
PUBLIC_DATA_API_KEY=
PUBLIC_DATA_BATCH_SIZE=50

# V-WORLD 부동산중개업사무소 조회 (공인중개사 검증 대조, 세션 308 PR B)
# 미설정 시 중개사 대조 건너뜀 → 국세청 통과해도 pending(수동심사). 둘 다 설정해야 자동승인 동작.
# VWORLD_DOMAIN = api key 발급 시 등록한 서비스 도메인 (서버사이드 호출 시 필수, 없으면 INCORRECT_KEY)
VWORLD_API_KEY=
VWORLD_DOMAIN=www.2u.pe.kr
# 시세 이력 소급 수집 배치 (매일 03:30, PUBLIC_DATA_ENABLED 시 활성)
# data.go.kr 일일 쿼터(10,000회, mibunyang 공유) 보호 위해 작게 유지
PUBLIC_PRICE_BACKFILL_BATCH_SIZE=30

# 에어코리아 대기질 수집 (선택사항 — 매일 02:00, data.go.kr 동일 키)
AIR_QUALITY_ENABLED=false
AIR_QUALITY_BATCH_SIZE=100

# 응급의료기관 수집 (선택사항 — 매월 첫째 월요일 03:00, data.go.kr 동일 키)
EMERGENCY_ENABLED=false
EMERGENCY_BATCH_SIZE=100

# 어린이집 수집 (선택사항 — 매월 첫째 목요일 06:00, 보육정보공개포털 자체 키)
# info.childcare.go.kr 활용신청 후 발급받은 인증키 (data.go.kr 키와 별도)
# cpmsapi030 "어린이집별 기본정보 조회" — arcode만 보내면 시군구 전체 상세+좌표 반환
CHILDCARE_ENABLED=false
CHILDCARE_BATCH_SIZE=100
CHILDCARE_DETAIL_API_KEY=
# (폴백) cpmsapi021 전국 어린이집 정보조회 — 현재 사용 안 함
CHILDCARE_API_KEY=

# 범죄통계 수집 (선택사항 — 분기별 첫째 일요일 04:00, odcloud API, 동일 키)
CRIME_STATS_ENABLED=false

# Redis (Rate Limiting용, 선택사항 — 미설정 시 in-memory 폴백)
# REDIS_URL=redis://localhost:6379/0

# 크롤링 모니터 + 텔레그램 알림
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 크롤링 장애 모니터 — false 면 텔레그램 장애 알림이 전혀 발송되지 않음.
# 운영 서버에서는 true 권장 (TELEGRAM_* 도 함께 설정해야 실제 발송).
MONITOR_ENABLED=false
MONITOR_INTERVAL_MIN=10
MONITOR_COOLDOWN_HOURS=6

# SMTP (공인중개사 검증 알림 메일 — USER/PASS 미설정 시 메일 발송 건너뜀)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 발신자 주소 (미설정 시 SMTP_USER 사용)
SMTP_FROM=

# PortOne(포트원) 결제 — 유료 구독 결제 (결제 PR3, 세션 321)
# 미설정 시 결제 엔드포인트 503 (사장님 포트원 가입 후 개발자콘솔에서 발급 → 주입).
# PORTONE_API_SECRET = 서버 결제조회·검증용 API Secret (절대 FE 노출 금지)
# PORTONE_STORE_ID / PORTONE_CHANNEL_KEY = FE 결제창 호출용 (prepare 응답으로 전달)
# PORTONE_WEBHOOK_SECRET = 웹훅 서명 검증용 (결제알림 Webhook 관리에서 발급)
PORTONE_API_SECRET=
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_WEBHOOK_SECRET=
