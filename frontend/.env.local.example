# FastAPI 백엔드 URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# 관리자 이메일 (쉼표 구분, 필수 — 미설정 시 관리자 접근 차단)
ADMIN_EMAIL=your-admin@example.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# SEO — 사이트 절대 URL (canonical / OG / sitemap 에 사용)
# 운영: https://2u.pe.kr / 로컬 개발: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://2u.pe.kr

# 검색엔진 사이트 소유 인증 코드 (선택 — 빈 값이면 메타태그 출력 안 됨)
# Google Search Console: https://search.google.com/search-console 가입 → "URL 접두어" → 메타태그 발급
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Naver 웹마스터: https://searchadvisor.naver.com 가입 → 사이트 등록 → 메타태그 발급
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
