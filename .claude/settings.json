{
  "permissions": {
    "allow": [
      "Bash(python -m uvicorn main:app --host 0.0.0.0 --port 8002)",
      "Bash(python scripts/startup_orchestrator.py)",
      "Bash(python -m pytest:*)",
      "Bash(python -c \"import requests\")",
      "Bash(ruff check .)",
      "Bash(ruff check --fix .)",
      "Bash(npm --version)",
      "Bash(npm list:*)",
      "Bash(npm audit:*)",
      "Bash(npx tsc --noEmit)",
      "Bash(npx vitest run:*)",
      "Bash(npx playwright test:*)",
      "Bash(where node:*)",
      "Bash(where npx:*)",
      "Bash(where ruff:*)",
      "Bash(where.exe npx:*)",
      "Bash(tasklist)",
      "Bash(netstat -ano)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8002/api/health)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8002/api/stats)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" https://api.2u.pe.kr/api/stats)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" https://www.2u.pe.kr)",
      "Bash(curl -s -I -X OPTIONS http://localhost:8002/api/complexes/*)",
      "Read(//c/Users/user/AppData/Roaming/Microsoft/Windows/Start Menu/Programs/Startup/**)"
    ],
    "additionalDirectories": [
      "C:\\Users\\user\\.claude\\plans",
      "C:\\Users\\user\\AppData\\Roaming\\Microsoft\\Windows\\Start Menu\\Programs\\Startup"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"const i=JSON.parse(require('fs').readFileSync(0,'utf8'));const p=i.tool_input?.file_path||'';const c=i.tool_input?.new_string||i.tool_input?.content||'';if(p.endsWith('CLAUDE.md')&&/^(##|\\*\\*).*?(마지막 작업|과거 작업|직전 작업|현재 진행 상황|과거 세션 \\(세션|\\(세션 \\d+)/m.test(c)){console.error('BLOCKED: CLAUDE.md 진행 박제 금지 (.claude/rules/planning.md L43). 메모리 활용: ~/.claude/projects/.../memory/session{N}_summary.md');process.exit(2);}\" < /dev/stdin"
          }
        ]
      }
    ]
  }
}
